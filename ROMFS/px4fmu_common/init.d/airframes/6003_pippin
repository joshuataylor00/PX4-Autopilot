#!/bin/sh
#
# @name pippin
# @type Hexarotor x coaxial front
# @class Copter
# @maintainer Joshua Taylor <joshua.taylor@u.nus.edu>
#
. ${R}etc/init.d/rc.mc_defaults

param set-default MAV_TYPE 13 # MAV_TYPE_HEXAROTOR

param set-default CA_ROTOR_COUNT 6

# front right top - 0
# back left - 1
# front left - 2
# back right - 3
# front right bottom - 4
# front left bottom - 5


param set-default CA_ROTOR0_PX  0.165
param set-default CA_ROTOR0_PY 0.185
param set-default CA_ROTOR0_PZ  0.0
param set-default CA_ROTOR0_KM 0.05

param set-default CA_ROTOR1_PX -0.165
param set-default CA_ROTOR1_PY -0.188
param set-default CA_ROTOR1_PZ  0.0
param set-default CA_ROTOR1_KM  0.05

param set-default CA_ROTOR2_PX 0.165
param set-default CA_ROTOR2_PY  -0.185
param set-default CA_ROTOR2_PZ  0.0
param set-default CA_ROTOR2_KM -0.05

param set-default CA_ROTOR3_PX  -0.165
param set-default CA_ROTOR3_PY  0.188
param set-default CA_ROTOR3_PZ  0.0
param set-default CA_ROTOR3_KM  -0.05

param set-default CA_ROTOR4_PX  0.165
param set-default CA_ROTOR4_PY 0.185
param set-default CA_ROTOR4_PZ -0.04
param set-default CA_ROTOR4_KM  -0.05

param set-default CA_ROTOR5_PX  0.165
param set-default CA_ROTOR5_PY  -0.185
param set-default CA_ROTOR5_PZ -0.04
param set-default CA_ROTOR5_KM 0.05

mavlink start -d /dev/ttyS6 -b 921600

# sleep 1

mavlink stream -d /dev/ttyS6 -s ACTUATOR_CONTROL_TARGET -r 0
mavlink stream -d /dev/ttyS6 -s ATTITUDE -r 200
mavlink stream -d /dev/ttyS6 -s ALTITUDE -r 0
mavlink stream -d /dev/ttyS6 -s ATTITUDE_TARGET -r 0
mavlink stream -d /dev/ttyS6 -s HIGHRES_IMU -r 200
mavlink stream -d /dev/ttyS6 -s LOCAL_POSITION_NED -r 200
mavlink stream -d /dev/ttyS6 -s ODOMETRY -r 0
mavlink stream -d /dev/ttyS6 -s SCALED_IMU -r 0
mavlink stream -d /dev/ttyS6 -s SCALED_IMU2 -r 0
mavlink stream -d /dev/ttyS6 -s SCALED_IMU3 -r 0
mavlink stream -d /dev/ttyS6 -s TIMESYNC -r 0
mavlink stream -d /dev/ttyS6 -s VFR_HUD -r 0
mavlink stream -d /dev/ttyS6 -s LANDING_TARGET -r 0
mavlink stream -d /dev/ttyS6 -s ATTITUDE_QUATERNION -r 0
mavlink stream -d /dev/ttyS6 -s DISTANCE_SENSOR -r 0
mavlink stream -d /dev/ttyS6 -s RC_CHANNELS -r 0
mavlink stream -d /dev/ttyS6 -s GPS_RAW_INT -r 0
mavlink stream -d /dev/ttyS6 -s GPS2_RAW -r 0
mavlink stream -d /dev/ttyS6 -s GPS_STATUS -r 0
mavlink stream -d /dev/ttyS6 -s DEBUG -r 200
mavlink stream -d /dev/ttyS6 -s SERVO_OUTPUT_RAW_1 -r 200
mavlink stream -d /dev/ttyS6 -s ESC_STATUS -r 200
mavlink stream -d /dev/ttyS6 -s BATTERY_STATUS -r 200
mavlink stream -d /dev/ttyS6 -s HEARTBEAT -r 20












